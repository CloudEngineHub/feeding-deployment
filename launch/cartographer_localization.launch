<launch>
  <!-- Localization against a prebuilt Cartographer state (.pbstream). -->
  <arg name="config_dir" default="$(find feeding_deployment)/config"/>
  <arg name="config_basename" default="vention_2lidar_localization.lua"/>
  <arg name="load_state_filename" default="/tmp/vention_map.pbstream"/>
  <arg name="load_frozen_state" default="true"/>
  <!-- map_odom_clamp params. Cartographer's map_frame is renamed to "map_carto"
       (see config/vention_2lidar_localization.lua); this node owns map->map_carto
       and absorbs spurious parked jumps so consumers keep using "map".
       NOTE: scan_gate (which "froze" map->odom by DROPPING scans) is retired;
       starving Cartographer wedged it and killed the map frame
       (session_20260723 14:48:41). Cartographer now always gets raw scans. -->
  <!-- Parked = no /cmd_vel[_teleop] for this long. LONGER than navigate.py's
       15 s goal-confirm settle so the fine-parking catch-up correction reaches
       move_base before the clamp engages. 0 disables the parked clamp. -->
  <arg name="clamp_park_freeze_s" default="30.0"/>
  <!-- While parked, a single map_carto->odom step bigger than these is absorbed
       (held). Feeding yanks are 2-7 m; real parked drift is sub-cm. 0 = pin. -->
  <arg name="clamp_lin_jump_m" default="0.05"/>
  <arg name="clamp_ang_jump_rad" default="0.03"/>
  <!-- false -> node publishes map->map_carto = identity forever = raw
       Cartographer (jumpy but correct): the safe fallback / A-B toggle. -->
  <arg name="clamp_enabled" default="true"/>

  <!-- Owns map->map_carto (identity by default). Must run continuously: the
       global_costmap StaticLayer and every map-frame TF lookup depend on it. -->
  <node pkg="feeding_deployment" type="map_odom_clamp.py" name="map_odom_clamp"
        output="screen" respawn="true" respawn_delay="2">
    <param name="park_freeze_s" value="$(arg clamp_park_freeze_s)"/>
    <param name="lin_jump_m" value="$(arg clamp_lin_jump_m)"/>
    <param name="ang_jump_rad" value="$(arg clamp_ang_jump_rad)"/>
    <param name="enabled" value="$(arg clamp_enabled)"/>
  </node>

  <!-- Cartographer node in localization mode. Subscribes to RAW scans now
       (scan_gate retired): starving it wedged it and killed the map frame. -->
  <node pkg="cartographer_ros" type="cartographer_node" name="cartographer_node" output="screen"
        args="-configuration_directory $(arg config_dir)
              -configuration_basename $(arg config_basename)
              -load_state_filename $(arg load_state_filename)
              -load_frozen_state $(arg load_frozen_state)">
    <remap from="scan_2" to="/lidar_l/scan"/>
    <remap from="scan_1" to="/lidar_r/scan"/>
    <!-- Fused wheel+IMU odometry (ekf_fused_imu_wheel in sensors.launch, which
         also owns the odom->vention_base_link TF). child_frame_id equals the
         tracking_frame, so no TF hop. Was the sanitized ZED VIO
         (/zed_mini/zed_node/odom_sanitized) until Jul 2026; VIO jumps kept
         dragging localization (e.g. 31.5 m excursion, session jul10-6). -->
    <remap from="odom" to="/odometry/fused_imu_wheel"/>
  </node>

  <!-- Publish occupancy grid as /map. -->
  <node pkg="cartographer_ros" type="cartographer_occupancy_grid_node" name="occupancy_grid_node" output="screen">
    <param name="resolution" value="0.05"/>
    <param name="publish_period_sec" value="1.0"/>
  </node>
</launch>